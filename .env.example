# QQ 开放平台专用配置模板：复制为 .env 后填写

# ── 运行环境 ──
ENVIRONMENT=dev
# WebSocket 出站需要 HTTPClient；ASGI 保留给健康检查
DRIVER=~fastapi+~httpx+~websockets
HOST=0.0.0.0
PORT=8080
LOCALSTORE_DATA_DIR=data
LOCALSTORE_CONFIG_DIR=data/config
LOCALSTORE_CACHE_DIR=data/cache

# ── QQ 开放平台 ──
QQ_IS_SANDBOX=false
# 群主开启"接收全量消息"后设为 true（决定群摘要是否生成）
QQ_GROUP_FULL_MESSAGES=false
# AppID / AppSecret 从 q.qq.com → 开发设置 获取（单行 JSON，整段用单引号包住）
QQ_BOTS=[{"id":"<AppID>","secret":"<AppSecret>","intent":{"c2c_group_at_messages":true,"interaction":true},"use_websocket":true}]

# ── PostgreSQL ──
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=qq_bot_official
PG_USER=postgres
PG_PASSWORD=<数据库密码>

# ── 模型 API ──
DEEPSEEK_API_KEY=<DeepSeek 密钥>
GLM_API_KEY=<智谱密钥>

# ── 搜索 ──
TAVILY_KEY=<Tavily 密钥>

# ── 视频理解 ──
# 默认后台：先回“我去看看”，分析完再单独回复；关掉则回到阻塞式工具调用
VIDEO_BACKGROUND_ENABLED=true
# 系统依赖 ffmpeg/ffprobe；yt-dlp 由 uv sync 安装
# B 站 AI 字幕通常需要登录 Cookie（至少 SESSDATA=...；匿名一般只能看公开 CC）
BILIBILI_COOKIE=
# 可选：yt-dlp 的 cookies.txt 路径（B 站/抖音风控时）
VIDEO_YTDLP_COOKIES=
# 可选：视频理解模型；留空使用默认模型
VIDEO_VISION_MODEL=
# 视频上限：30 分钟 / 512MB；超过仍会抽帧，但会明确提示
VIDEO_MAX_DURATION=1800
VIDEO_MAX_MB=512
# 最大 12 帧；优先 scdet 场景帧，不足时均匀补帧
VIDEO_MAX_FRAMES=12
# 送给视觉模型的字幕字符上限，避免长字幕拖慢推理
VIDEO_MAX_SUBTITLE_CHARS=6000
# 视频下载超时（秒）；30 分钟视频在慢网络下需要更久
VIDEO_DOWNLOAD_TIMEOUT=600
VIDEO_YTDLP_TIMEOUT=900
# 单个后台视频任务的总超时（含下载、抽帧、视觉理解）
VIDEO_JOB_TIMEOUT=1800
# scdet 场景阈值，越大越不敏感
VIDEO_SCENE_THRESHOLD=10

# ── 记忆与行为开关 ──
MEMORY_INJECTION_ENABLED=true
GLOSSARY_ENABLED=true

# ── 本地文件路径 ──
STICKERS_DIR=data/data/qqbot_official/stickers
SESSION_MODELS_FILE=data/data/qqbot_official/session_models.json

# ── 管理（/reboot 白名单，openid 逗号分隔）──
# 注意：openid 按 AppID 隔离，换机器人后必须重新填
ADMIN_OPENIDS=<管理员 openid1>,<管理员 openid2>

# ── 群聊存在感 P1（0-1 抽奖 + 10 分钟窗口 + 静默 + 复读）──
# 设计见 docs/spec/group-presence.md；0 = 永不主动，1 = 每条都抽中
GROUP_PRESENCE_ENABLED=true
GROUP_PRESENCE_RATE=0.2
GROUP_PRESENCE_WINDOW_SEC=600
GROUP_PRESENCE_RATE_IN_WINDOW=2.0
GROUP_PRESENCE_REPLY_COOLDOWN_SEC=15
GROUP_PRESENCE_WAKE_COOLDOWN_SEC=300
GROUP_PRESENCE_DAILY_ACTIVE=120
GROUP_PRESENCE_MUTE_SEC=1800
GROUP_PRESENCE_MUTE_WORDS=闭嘴,别说了,安静
GROUP_PRESENCE_MUTE_ACK=好
GROUP_PRESENCE_IGNORE_OPENIDS=
GROUP_PRESENCE_IMAGE_RATE_MULT=0.5
GROUP_PRESENCE_REPEAT_ENABLED=true
GROUP_PRESENCE_REPEAT_MIN_USERS=3
GROUP_PRESENCE_REPEAT_WINDOW_SEC=90
GROUP_PRESENCE_REPEAT_MAX_CHARS=20
# 关键词触发（P2）：名字出现 → CALL/ABOUT/HOMONYM 分类
GROUP_PRESENCE_KEYWORDS=大肥鱼
GROUP_PRESENCE_KEYWORD_COOLDOWN_SEC=120
GROUP_PRESENCE_KEYWORD_USER_COOLDOWN_SEC=300
GROUP_PRESENCE_KEYWORD_WINDOW_SEC=300
GROUP_PRESENCE_HOOK_SEC=120
GROUP_PRESENCE_HOOK_RATE=1.0
GROUP_PRESENCE_KEYWORD_HOMONYM_MODE=skip
GROUP_PRESENCE_KEYWORD_CONTEXT_MESSAGES=15
GROUP_PRESENCE_KEYWORD_FALLBACK=什么意思
