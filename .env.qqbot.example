# QQ 开放平台接入：把这些键合并进 .env（不再使用 .env.qq）
# 切换平台只改 PLATFORM，然后重启 ./run_bot.sh

PLATFORM=qq
QQ_IS_SANDBOX=false

# AppID / AppSecret 从 q.qq.com → 开发设置 获取（单行 JSON，整段用单引号包住）
QQ_BOTS=[{"id":"<AppID>","secret":"<AppSecret>","intent":{"c2c_group_at_messages":true},"use_websocket":true}]

# WebSocket 出站需要 HTTPClient；ASGI 保留给健康检查/反向上报
DRIVER=~fastapi+~httpx+~websockets

# 与 OneBot 实例并存时改端口；单独跑 QQ 可保持 8080
PORT=8081
